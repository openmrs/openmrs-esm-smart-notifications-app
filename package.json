{
  "name": "@openmrs/esm-smart-notifications-app",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "smart-notifications-app frontend module for O3",
  "browser": "dist/openmrs-esm-smart-notifications-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "build": "rspack --mode production",
    "build:development": "rspack --mode development",
    "analyze": "rspack --mode=production --env.analyze=true",
    "serve": "rspack serve --mode=development",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typescript": "tsc",
    "lint": "eslint src --ext ts,tsx",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/**/*.extension.tsx' 'src/**/*.modal.tsx' 'src/index.ts' --config ./tools/i18next-parser.config.js",
    "prettier": "prettier --config prettier.config.js --write \"src/**/*.{ts,tsx,css,scss}\"",
    "postinstall": "husky install"
  },
  "keywords": [
    "openmrs",
    "microfrontends"
  ],
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmrs/openmrs-esm-smart-notifications-app.git"
  },
  "bugs": {
    "url": "https://github.com/openmrs/openmrs-esm-smart-notifications-app/issues"
  },
  "homepage": "https://github.com/openmrs/openmrs-esm-smart-notifications-app#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@carbon/react": "^1.83.0",
    "classnames": "^2.5.1"
  },
  "peerDependencies": {
    "@carbon/react": "1.x",
    "@openmrs/esm-framework": "*",
    "dayjs": "1.x",
    "i18next": "25.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "react-is": "18.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "sass": "1.x",
    "single-spa": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "next",
    "@openmrs/rspack-config": "next",
    "@rspack/cli": "^1.7.10",
    "@rspack/core": "^1.7.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest-dom": "^5.4.0",
    "eslint-plugin-playwright": "^0.16.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^6.2.2",
    "husky": "^9.0.11",
    "i18next": "^25.0.0",
    "i18next-parser": "^9.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^28.0.0",
    "lint-staged": "^15.2.2",
    "openmrs": "next",
    "prettier": "^3.2.5",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-i18next": "^16.0.0",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.3.0",
    "rxjs": "^6.5.3",
    "sass": "^1.33.0",
    "single-spa": "^6.0.0",
    "swr": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix --max-warnings 0",
    "*.{css,scss,ts,tsx}": "prettier --write --list-different"
  },
  "packageManager": "yarn@4.10.3"
}
