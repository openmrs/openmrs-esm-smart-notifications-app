{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "esnext",
    "target": "es2015",
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": [
      "dom",
      "es5",
      "scripthost",
      "es2015",
      "es2015.promise",
      "es2016.array.include",
      "es2018",
      "es2020",
      "es2022",
      "esnext"
    ],
    "noEmit": true,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "__mocks__": ["./__mocks__/index.ts"],
      "@core/*": ["./src/core/*"],
      "@sources/*": ["./src/sources/*"],
      "@tools/*": ["./tools/*"],
      "@constants": ["./src/constants"]
    }
  },
  "include": ["src/**/*", "__mocks__/**/*", "tools/setup-tests.ts", "vitest.config.ts"],
  "types": ["react", "react-dom", "fhir", "vitest/globals"]
}
